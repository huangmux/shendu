# 复制为 .env 后填写。Docker Compose 会读取同目录 .env。
# 也可在应用「模型设置」页填写；若这里设置了 LLM_API_KEY，将优先于页面配置。
# 接口需兼容 OpenAI Chat Completions：POST {LLM_BASE_URL}/chat/completions

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 常见第三方示例（只改这三项）：
# DeepSeek     LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
# 通义千问     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# 月之暗面     LLM_BASE_URL=https://api.moonshot.cn/v1           LLM_MODEL=moonshot-v1-8k
# SiliconFlow  LLM_BASE_URL=https://api.siliconflow.cn/v1        LLM_MODEL=deepseek-ai/DeepSeek-V3
# OpenAI       LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
